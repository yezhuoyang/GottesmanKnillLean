/-! ### Generator-preservation (`thm:stabgenerate`)

After applying `m` Clifford unitaries to `|0⟩^⊗n`, the stabilizer is generated by
exactly `n` Pauli operators — namely the images of `Z_1, …, Z_n` under the
composed Clifford map.

Concretely, if `Gs : Fin m → Clifford n` is the gate sequence, set

  ψ_k := (∏_{j<k} (Gs j : Unitary n)) • |0⟩^⊗n.

Then `Stab(ψ_m) = ⟨ M[G_{m-1}] ∘ ⋯ ∘ M[G_0] (Z_1), …, M[G_{m-1}] ∘ ⋯ ∘ M[G_0] (Z_n) ⟩`.
-/

/-- The composed Clifford map after a sequence of `m` gates. -/
noncomputable def composedMap (Gs : List (Clifford n)) : PauliOp n →* PauliOp n :=
  Gs.foldr (fun g acc => acc.comp (Clifford.mapPauliHom g)) (MonoidHom.id _)
  -- TODO(you): check the fold direction; possibly should be `foldl`.

/-- The "tableau" after `m` Clifford gates: the `n` Pauli generators we need to track. -/
noncomputable def tableau (Gs : List (Clifford n)) : Fin n → PauliOp n :=
  fun i => composedMap Gs (PauliOp.singleZ i)

/-- `thm:stabgenerate`: after the gate sequence `Gs` applied to `|0⟩^⊗n`,
the stabilizer is generated by `tableau Gs`. -/
